# Environment Variables Example

# App Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connection (PostgreSQL with Prisma)
# Replace with your actual PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/magnific_sfx?schema=public"

# Optional Cloud Storage (e.g. AWS S3, Cloudflare R2, MinIO)
# S3_BUCKET_NAME=sfx-audio-assets
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
